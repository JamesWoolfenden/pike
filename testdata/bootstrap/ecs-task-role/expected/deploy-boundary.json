{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateRoleWithRequiredBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/terraform-managed/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::123456789012:policy/boundaries/TerraformWorkloadBoundary"
        }
      }
    },
    {
      "Sid": "DenyAccessKeyManagement",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:UpdateAccessKey"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "DenyBoundaryPolicyMutation",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:policy/boundaries/*"
      ]
    },
    {
      "Sid": "DenyHumanPrincipalManagement",
      "Effect": "Deny",
      "Action": [
        "iam:CreateLoginProfile",
        "iam:CreateUser",
        "iam:CreateVirtualMFADevice",
        "iam:DeactivateMFADevice",
        "iam:DeleteLoginProfile",
        "iam:DeleteUser",
        "iam:DeleteVirtualMFADevice",
        "iam:EnableMFADevice",
        "iam:ResyncMFADevice",
        "iam:UpdateLoginProfile",
        "iam:UpdateUser"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "DenyOrganizationManagement",
      "Effect": "Deny",
      "Action": [
        "account:*",
        "organizations:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "DenyWorkloadBoundaryRemoval",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/terraform-managed/*"
      ]
    },
    {
      "Sid": "IAMRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "ManageTerraformRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/terraform-managed/*"
      ]
    },
    {
      "Sid": "NonIAM0",
      "Effect": "Allow",
      "Action": [
        "ecs:DeregisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTagsForResource",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "PassManagedRolesToApprovedServices",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::123456789012:role/terraform-managed/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com"
          ]
        }
      }
    }
  ]
}
